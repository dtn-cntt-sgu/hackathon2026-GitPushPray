# Local only. Không commit file .env thật.
PORT=8787
ENVIRONMENT=local
# Để trống khi chạy local: dùng store trong bộ nhớ. Chỉ đặt khi có DynamoDB.
TABLE_NAME=

# none = kill switch; groq = gọi Groq
AI_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL_SMALL=openai/gpt-oss-120b
GROQ_MODEL_LARGE=openai/gpt-oss-120b
# low, medium hoặc high. Để trống thì dùng mặc định của Groq.
GROQ_REASONING_EFFORT=
# Giá Groq gpt-oss-120b (USD / 1K token) để tính metrics
GROQ_COST_PER_1K_INPUT_USD=0.00015
GROQ_COST_PER_1K_OUTPUT_USD=0.00075
AI_TIMEOUT_SMALL_MS=8000
AI_TIMEOUT_LARGE_MS=10000
AI_CONTEXT_MESSAGES=8
AI_MAX_NEW_MESSAGES=50
AI_MAX_INPUT_CHARS=20000
AI_MAX_INPUT_TOKENS=7500
AI_MAX_SIGNALS=8
AI_MAX_OUTPUT_TOKENS_SMALL=2048
AI_MAX_OUTPUT_TOKENS_LARGE=4096
AI_ESCALATION=on

# Secret ký token thiết bị (chuỗi ngẫu nhiên >= 32 byte)
TOKEN_SECRET=
TOKEN_SECRET_PREVIOUS=
TOKEN_TTL_HOURS=24

DEVICE_RPM=4
DEVICE_DAILY_CALLS=50
DEVICE_ISSUE_RPM=10
GLOBAL_RPM=20
GLOBAL_DAILY_CALLS=500
GLOBAL_DAILY_TOKENS=2000000
MAX_BODY_BYTES=262144

ALLOWED_ORIGINS=
PROMPT_VERSION=v2

# Bắt buộc nếu gọi /v1/metrics/summary
METRICS_ADMIN_TOKEN=
