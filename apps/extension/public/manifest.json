{
  "manifest_version": 3,
  "name": "SafeChat AI (prototype)",
  "version": "0.4.0",
  "description": "Hỗ trợ nhận biết dấu hiệu lừa đảo (việc làm, đầu tư, mạo danh, chiếm đoạt tài khoản, dụ dỗ) trong cuộc trò chuyện Messenger do bạn chọn.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Mở SafeChat AI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.messenger.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*.amazonaws.com/*",
    "https://*.cloudfront.net/*",
    "https://*.on.aws/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://www.messenger.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}